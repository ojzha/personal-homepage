---
import { ArrowRight, Download, ExternalLink } from "lucide-astro";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import PublicationCard from "@components/PublicationCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { getProfile } from "@data/profile";
import { publications } from "@data/publications";
import { projects } from "@data/projects";
import { getRoute } from "@data/i18n";
import { withBase } from "@utils/paths";
import portraitImage from "../../assets/images/profile/portrait.webp";

const profile = getProfile("en");
const featuredPublications = publications.filter((publication) => publication.featured).slice(0, 4);
const featuredProjects = projects.filter((project) => project.featured).slice(0, 2);
---

<Layout locale="en" pageKey="home" title="Chengxu Gong | Academic Homepage" description={profile.summary}>
  <section class="home-intro">
    <div class="profile-panel">
      <p class="section-kicker home-affiliation-line">{profile.affiliation} · {profile.degree}</p>
      <h1>{profile.name}</h1>
      <p class="tagline">{profile.tagline}</p>
      <p class="summary">{profile.summary}</p>
      <div class="action-row">
        <a class="button primary" href={withBase(getRoute("publications", "en"))}>View Publications <ArrowRight size={17} /></a>
        <a class="button secondary" href={withBase("/files/GCX_resume_v5.pdf")}>Download CV (Chinese PDF) <Download size={17} /></a>
      </div>
      <div class="profile-links" aria-label="Academic profiles">
        {
          profile.links.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label} <ExternalLink size={15} />
            </a>
          ))
        }
      </div>
    </div>

    <aside class="overview-panel portrait-panel">
      <div class="portrait-frame">
        <Image src={portraitImage} alt="Portrait of Chengxu Gong" loading="eager" />
      </div>
      <div class="stats-compact">
        {profile.stats.map((item) => <div><strong>{item.value}</strong><span>{item.label}</span></div>)}
      </div>
    </aside>
  </section>

  <section class="section-block">
    <div class="section-title">
      <p class="section-kicker">Research Focus</p>
      <h2>Connecting sensing, intelligent modeling, and deployable systems.</h2>
      <p>{profile.focus}</p>
    </div>
    <div class="keyword-grid">
      {profile.researchKeywords.map((keyword) => <span>{keyword}</span>)}
    </div>
    <div class="info-grid">
      {profile.publicInfo.map((item) => <div><span>{item.label}</span><strong>{item.value}</strong></div>)}
    </div>
  </section>

  <section class="section-block">
    <div class="section-title-row">
      <div>
        <p class="section-kicker">Selected Publications</p>
        <h2>First-author work and high-impact collaborations</h2>
      </div>
      <a class="text-link" href={withBase(getRoute("publications", "en"))}>All Publications <ArrowRight size={16} /></a>
    </div>
    <div class="publication-list compact-list">
      {featuredPublications.map((publication, index) => <PublicationCard publication={publication} index={index + 1} locale="en" />)}
    </div>
  </section>

  <section class="section-block">
    <div class="section-title-row">
      <div>
        <p class="section-kicker">Research Projects</p>
        <h2>From multimodal signals to intelligent detection systems</h2>
      </div>
      <a class="text-link" href={withBase(getRoute("projects", "en"))}>All Projects <ArrowRight size={16} /></a>
    </div>
    <div class="project-list">
      {featuredProjects.map((project) => <ProjectCard project={project} locale="en" />)}
    </div>
  </section>
</Layout>
